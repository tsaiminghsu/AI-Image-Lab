{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "REPLACE_VIDEO_FILENAME"
    }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": ["1", 0]
    }
  },
  "3": {
    "class_type": "RIFE VFI",
    "inputs": {
