    "inputs": {
      "images": ["3", 0],
      "fps": 48.0
    }
  },
  "9": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["4", 0],
      "filename_prefix": "REPLACE_FILENAME_PREFIX",
