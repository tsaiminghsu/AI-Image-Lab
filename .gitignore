# Third-party installs - each is its own git clone with its own .venv/models,
# not part of this repo's history.
/ComfyUI/
/MuseTalk/
/SadTalker/

# Model weights - large binaries, sourced separately (see README.md "模型" section)
/models/

# Generated / regenerable data (recreate via generate_character.py)
/datasets/
/outputs/
/training/reference_candidates/

# Reserved for the future kohya_ss LoRA training phase (currently empty)
/evaluation/
/samples/
/captions/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
# Dev-only venv for pytest/ruff (requirements-dev.txt). Kept separate from
# ComfyUI\.venv so dev tools can never be frozen into comfyui-requirements.lock.txt.
/.venv-dev/
.pytest_cache/
.ruff_cache/

# Runtime / training logs - regenerable
training/logs/
training/*.log

# Node / Amplify (web/) - installed packages and CDK/sandbox build output,
# regenerable via `npm install` / `npx ampx sandbox` (see web/README.md)
node_modules/
web/.amplify/
web/cdk.out/
web/amplify_outputs.json

# OS
Thumbs.db
.DS_Store
training/settings/

# Voice-clone reference recordings for training/drama.py (training/voices/<id>/voice.json +
# prompt.wav). Real people's voices, recorded with their consent - never committed.
/training/voices/

# MiniMax H3 Colab skill (.claude/skills/minimax-h3-colab): generated clips, job records and logs, the
# user's input images, and the machine-local config. Credentials never belong in any of them - the
# google-colab-cli OAuth token lives in its Docker volume (h3-colab-config) - but ignore the usual
# credential file names anyway so a stray copy can't be committed.
/output/
/input/
.claude/skills/minimax-h3-colab/config/config.json
.env
.env.*
token.json
client_secret*.json

# Z-Image Colab skill (.claude/skills/z-image-colab): the machine-local config. Its queue, images, logs
# and ledgers live under /output/zimage/ (ignored above). It shares the H3 skill's google-colab-cli Docker
# volume for the OAuth token, so no credential file belongs in the repo; these names are ignored anyway.
.claude/skills/z-image-colab/config/config.json
credentials/
secrets/
*.token
*.key
